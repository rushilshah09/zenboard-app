# Copy to .env.local and fill in. See SETUP.md for where each value comes from.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — never exposed to the browser

# Google OAuth (Google Cloud → Credentials) — for Google sign-in + Calendar sync
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=       # server only

# AI provider (Phase 4). One adapter, switch with AI_PROVIDER.
AI_PROVIDER=gemini                # gemini | anthropic | openai
GEMINI_API_KEY=                   # server only (Google AI Studio key)
GEMINI_MODEL=gemini-2.5-flash     # default model for the AI companion

# Optional transactional email (invoice sending, Phase 4)
RESEND_API_KEY=                   # server only
